{
  "extends": "./tsconfig.app.json",
  "include": [
    "env.d.ts",
    "src/**/*.test.ts",
    "src/test/**/*",
    "src/**/*.vue",
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/__tests__/*"
  ],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.vitest.tsbuildinfo",
    "types": [
      "vite/client",
      "node"
    ],
    "noEmit": true
  }
}
