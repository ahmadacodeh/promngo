{
  "name": "@promango/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PROMANGO web client — Vue 3 + TypeScript (Arabic RTL)",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.vitest.json && vue-tsc --noEmit -p tsconfig.node.json",
    "lint": "oxlint --deny-warnings src e2e",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource/cairo": "^5.3.0",
    "pinia": "3.0.4",
    "vue": "3.5.45",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "jsdom": "27.4.0",
    "oxlint": "1.93.0",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "4.1.12",
    "vue-tsc": "3.3.14"
  }
}
