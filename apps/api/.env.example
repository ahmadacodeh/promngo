# نسخة غير سرية. انسخها إلى .env وعدّل القيم. لا تضع أسرارًا حقيقية هنا أبدًا.
NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
# 1 عند وجود reverse proxy موثوق أمام الخادم (لقراءة IP الحقيقي)
TRUST_PROXY=0

# قاعدة البيانات
DATABASE_URL=postgresql://promango_app:CHANGE_ME@localhost:5432/promango_dev
# اتصال مشفر مع PostgreSQL: false | true (تحقق من الشهادة) | no-verify (تشفير بلا تحقق، للاختبار فقط)
DATABASE_SSL=false
# مسار شهادة CA عند DATABASE_SSL=true (اختياري)
DATABASE_SSL_CA=

# أسرار (32 حرفًا على الأقل لكل منها، ومختلفة عن بعضها). ولّدها: openssl rand -hex 32
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_at_least_32_chars
BILLING_ENCRYPTION_KEY=CHANGE_ME_billing_key_at_least_32_chars_long

# اختبارات E2E: يجب أن ينتهي اسم القاعدة بـ _test
TEST_DATABASE_URL=postgresql://promango_app:CHANGE_ME@localhost:5432/promango_test

# بيانات التطوير seed:dev فقط. اتركه فارغًا ليُولَّد ويُطبع مرة واحدة.
SEED_PASSWORD=
