{
  "name": "@promango/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PROMANGO REST API (NestJS + TypeORM + PostgreSQL)",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint -c .oxlintrc.json src test scripts",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "migration:run": "node dist/database/migrate.js run",
    "migration:revert": "node dist/database/migrate.js revert",
    "migration:show": "node dist/database/migrate.js show",
    "migration:create": "node scripts/new-migration.mjs",
    "seed:dev": "node dist/database/seed/seed-dev.js",
    "mutation:b2": "node scripts/mutation-b2.mjs",
    "verify": "npm run typecheck && npm run lint && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@nestjs/common": "12.4.2",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.4.2",
    "@nestjs/jwt": "12.0.4",
    "@nestjs/platform-express": "12.4.2",
    "@nestjs/typeorm": "12.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "18.0.10",
    "helmet": "8.3.0",
    "multer": "^2.5.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.12",
    "@nestjs/schematics": "12.0.13",
    "@nestjs/testing": "12.4.2",
    "@swc/core": "1.16.22",
    "@types/express": "5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "oxlint": "1.93.0",
    "supertest": "7.3.2",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0"
  }
}
